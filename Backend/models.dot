digraph model_graph {
  // Dotfile by Django-Extensions graph_models
  // Created: 2026-10-14 15:19
  // Cli Options: tracking --dot -o models.dot

  fontname = "Roboto"
  fontsize = 8
  splines  = true
  rankdir = "TB"
  

  node [
    fontname = "Roboto"
    fontsize = 8
    shape = "plaintext"
  ]

  edge [
    fontname = "Roboto"
    fontsize = 8
  ]

  // Labels


  tracking_models_Proprietaire [label=<
    <TABLE BGCOLOR="white" BORDER="1" CELLBORDER="0" CELLSPACING="0">
